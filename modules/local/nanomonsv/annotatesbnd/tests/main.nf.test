// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test nanomonsv/annotatesbnd
nextflow_process {

    name "Test Process NANOMONSV_ANNOTATESBND"
    script "../main.nf"
    process "NANOMONSV_ANNOTATESBND"

    tag "modules"
    tag "modules_"
    tag "nanomonsv"
    tag "nanomonsv/annotatesbnd"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("sbnd - annotatesbnd") {

        // TODO nf-core: If you are created a test for a chained module
        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the nf-test docs (https://www.nf-test.com/docs/testcases/setup/).

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here with sbnd_result_txt and bwa_index

                input[0] = [
                    [ id:'test' ],
                    file('test.sbnd.result.txt', checkIfExists: false),
                ]
                input[1] = file('path/to/bwa_index', checkIfExists: false)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
                //TODO nf-core: Add all required assertions to verify the test output.
                // See https://nf-co.re/docs/developing/testing/assertions for more information and examples.
            )
        }

    }

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used but keep the " - stub" suffix.
    test("sbnd - stub") {

        options "-stub"

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here with sbnd_result_txt and bwa_index

                input[0] = [
                    [ id:'test' ],
                    file('test.sbnd.result.txt', checkIfExists: false),
                ]
                input[1] = file('path/to/bwa_index', checkIfExists: false)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
