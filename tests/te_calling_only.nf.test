nextflow_pipeline {

    name "Test TE calling only workflow"
    script "../main.nf"
    tag "pipeline"

    test("TE calling only workflow") {
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/nanogenome/samplesheet_cna_only.csv'
                skip_phasing = true
                germline = false
                skip_somatic = true
                skip_cna = true
                te_calling = true
                longcalld_somatic_te = true
                longcalld_realign = true

            }
        }

        then {
            assert workflow.success
        }
    }
}
