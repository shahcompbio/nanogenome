nextflow_pipeline {

    name "Test T2T somatic sv calling only workflow"
    script "../main.nf"
    tag "pipeline"

    test("T2T somatic sv calling only workflow") {
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                genome_build = 't2t'
                germline = false
                skip_phasing = true
                skip_cna = true
                vntr_bed = 'https://raw.githubusercontent.com/KolmogorovLab/Severus/refs/heads/main/vntrs/chm13.bed'
                input = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/nanogenome/samplesheet_sv_only.csv'
            }
        }

        then {
            assert workflow.success
        }
    }
}
