nextflow_pipeline {

    name "Test somatic snv/indel calling workflow with clairS"
    script "../main.nf"
    tag "pipeline"
    tag "somatic_snv"

    test("somatic snv/indel calling with clairS") {
        when {
            params {
                outdir = "$outputDir"
                input = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/nanogenome/samplesheet_cna_only.csv'
                fasta = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/nanogenome/reference/GRCh38_chr22.fa'
                fai   = 'https://raw.githubusercontent.com/apsteinberg/test-datasets/nanogenome/reference/GRCh38_chr22.fa.fai'
                skip_phasing = true
                germline = false
                skip_somatic = true
                skip_cna = true
                te_calling = false
                somatic_snv_calling = true
                somatic_snv_caller = 'clairs'
                inhibit_vep = true
            }
        }

        then {
            assert workflow.success
        }
    }
}
