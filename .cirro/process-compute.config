process {
    executor      = 'awsbatch'
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Cap the nf-core label requests (process_high_memory asks for 200 GB * attempt)
    // at the largest instance your Cirro compute environment can provision.
    resourceLimits = [ cpus: 64, memory: 480.GB, time: 72.h ]
}

// Static references that users should never have to pick in the form.
// Upload these once to a bucket Cirro can read, then fill in the paths.
// Leave anything you don't use as null.
params {
    refdata_base       = 's3://YOUR-REFDATA-BUCKET/nanogenome'

    vntr_bed           = "${params.refdata_base}/severus/human_GRCh38_no_alt_analysis_set.trf.bed"
    vep_cache          = "${params.refdata_base}/vep_cache"
    annotsv_dir        = "${params.refdata_base}/annotsv"
    gene_annotations   = null
    oncokb             = "${params.refdata_base}/oncokb/cancerGeneList.txt"

    // TE calling (--te_calling)
    longcalld_te_fasta = "${params.refdata_base}/te/longcalld_te.fa"
    tldr_te_fasta      = "${params.refdata_base}/te/tldr_te.fa"

    // Insertion / single-breakend classification (--classify_inserts)
    ref_gtf            = "${params.refdata_base}/gencode/gencode.v45.annotation.gtf.gz"
    line1_db           = "${params.refdata_base}/nanomonsv/LINE1.hg38.bed.gz"
    famdb_dir          = "${params.refdata_base}/repeatmasker/famdb"
    bwa_index          = "${params.refdata_base}/bwa_index"

    // Cirro handles notifications; don't try to send mail from the head job
    email              = null
    email_on_fail      = null
}
