process {
    executor      = 'awsbatch'
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Cap the nf-core label requests (process_high_memory asks for 200 GB * attempt)
    // at the largest instance your Cirro compute environment can provision.
    resourceLimits = [ cpus: 64, memory: 480.GB, time: 72.h ]

    // Without these, vep_install also tries to build htslib (needs git, absent from
    // the container) and the Ensembl API. Download the cache only, non-interactively.
    withName: '.*:ENSEMBLVEP_DOWNLOAD' {
        ext.args = '--AUTO c --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE'
    }
}

// Reference files are set per run in the form ("Optional reference files").
// Cirro handles notifications; don't try to send mail from the head job.
params {
    email         = null
    email_on_fail = null
}
